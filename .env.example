# Copy to .env and adjust. Every value shown is the default unless marked "example".

# --- storage -------------------------------------------------------------------
STORE_BACKEND=postgres            # postgres | memory (memory loads the HTS at startup, no DB)
DATABASE_URL=postgresql://dev:dev@localhost:5432/landedcost
HTS_SNAPSHOT_PATH=data/hts/hts_2026-09-04.json.gz
HNSW_EF_SEARCH=400
FTS_RANKING=bm25                  # bm25 | ts_rank_cd
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10               # a hybrid query holds up to 4 connections at once
DB_CONNECT_TIMEOUT_S=5

# --- embeddings ----------------------------------------------------------------
EMBEDDING_PROVIDER=hash           # hash | openai | azure_openai | fastembed
EMBEDDING_DIM=384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_TIMEOUT_S=60            # per request to OpenAI / Azure OpenAI embeddings
EMBEDDING_MAX_RETRIES=3

# --- retrieval + abstention gate ---------------------------------------------------
RETRIEVAL_MODE=hybrid             # vector | fts | hybrid
RRF_K=60
RRF_WEIGHT_VECTOR=1.0             # see docs/eval/rrf-weights.md before changing
RRF_WEIGHT_FTS=1.0
RRF_WEIGHT_RULINGS=1.0
RETRIEVAL_CANDIDATE_POOL=50
GATE_MIN_SUPPORT=0.9
GATE_MIN_HEADING_CONSENSUS=0.3
GATE_WINDOW=10

# --- LLM (optional; default is extractive answers) ----------------------------------
LLM_PROVIDER=none                 # none | anthropic | openai | azure_openai
LLM_TIMEOUT_S=30                  # per request; after retries the answer falls back to extractive
LLM_MAX_RETRIES=2
ANTHROPIC_API_KEY=                # example: sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_USE_FALLBACKS=true
OPENAI_API_KEY=                   # example: sk-...
OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=            # example: https://my-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=     # example: gpt-4o-mini-deployment
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=  # example: text-embedding-3-small-deployment

# --- landed cost --------------------------------------------------------------------
# MPF min/max change every federal fiscal year (Oct 1). Defaults: FY2027, CBP Dec. 26-14.
# Verify against the current CBP user-fee notice; estimates warn once the year has ended.
FEE_SCHEDULE_FISCAL_YEAR=FY2027
MPF_RATE=0.003464
MPF_MIN_USD=34.58
MPF_MAX_USD=670.86
HMF_RATE=0.00125
FREIGHT_PROVIDER=static           # static (mock rate table) | http
FREIGHT_API_URL=                  # example: http://localhost:8102
FREIGHT_API_TIMEOUT_S=10

# --- API ------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8201

# --- tests ----------------------------------------------------------------------
# Integration tests read LANDEDCOST_TEST_DATABASE_URL from the shell (not from .env) and drop
# and recreate the tables there, so use a disposable database:
#   export LANDEDCOST_TEST_DATABASE_URL=postgresql://dev:dev@localhost:5432/landedcost_test
